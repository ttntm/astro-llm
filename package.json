{
  "name": "astro-llm",
  "version": "0.1.0",
  "description": "Generates a deterministic, static LLM-readable context file for Astro sites using a first-run config file",
  "homepage": "https://velohost.co.uk/plugins/astro-llm/",
  "repository": {
    "type": "git",
    "url": "https://github.com/velohost/astro-llm.git"
  },
  "bugs": {
    "url": "https://github.com/velohost/astro-llm/issues"
  },
  "license": "MIT",
  "type": "module",
  "keywords": [
    "withastro",
    "astro-integration",
    "llm",
    "ai",
    "context",
    "static-site",
    "build-time",
    "seo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc"
  },
  "peerDependencies": {
    "astro": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.0.0"
  }
}